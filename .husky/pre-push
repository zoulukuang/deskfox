#!/bin/sh
set -e
# FORK: bun 安装在外置 SSD,系统 PATH 里找不到,显式补进来
# ship 过程多次因 "bun: command not found" 被 pre-push 卡住 2026-06-03
export PATH="/Volumes/ExtSSD/.bun/bin:$PATH"
# Check if bun version matches package.json
# keep in sync with packages/script/src/index.ts semver qualifier
bun -e '
import { semver } from "bun";
const pkg = await Bun.file("package.json").json();
const expectedBunVersion = pkg.packageManager?.split("@")[1];
if (!expectedBunVersion) {
  throw new Error("packageManager field not found in root package.json");
}
const expectedBunVersionRange = `^${expectedBunVersion}`;
if (!semver.satisfies(process.versions.bun, expectedBunVersionRange)) {
  throw new Error(`This script requires bun@${expectedBunVersionRange}, but you are using bun@${process.versions.bun}`);
}
if (process.versions.bun !== expectedBunVersion) {
  console.warn(`Warning: Bun version ${process.versions.bun} differs from expected ${expectedBunVersion}`);
}
'
bun typecheck

# ============================================================
# FORK: Phase 1 e2e gate(fork 自加)
# [feat: e2e-pre-push-gate] 2026-05-23
#
# 只在 push 目标含 main 时触发(feat 分支 push 不卡 — 日常迭代 / 备份不付 e2e 成本)。
# vite mock 必须已跑在 :3000(开发时通常在另一终端 `bun run dev:e2e-mock` 常驻)。
# 不自动 spawn vite:跨平台 pid 管理 / 子进程清理在 Git Bash on Win 不可靠,简单失败 + 清楚指引更稳。
# 跳过:`git push --no-verify` + commit / 改动日志加 [override-pre-push: 理由]。
# ============================================================
push_to_main=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main) push_to_main=1 ;;
  esac
done

if [ "$push_to_main" = "1" ] || [ "$FORCE_E2E_GATE" = "1" ]; then
  echo ""
  echo "[pre-push] main gate — push 目标含 main(或 FORCE_E2E_GATE=1)"

  # ----------------------------------------------------------
  # FORK: fork 自家包单元测试闸(R5 决策 2「绿了再 merge」的自动 backstop)
  # [feat: test-gate-and-spec-cases] 2026-06-01
  #
  # 只跑 fork 自家维护、且有 test script 的包(media-gen / adapter-feishu-lark / app),
  # 不跑上游包(根 test 被故意禁;上游测试非我们维护,不该卡我们的 push)。
  # 主闸是 agent 在 feat 分支按 spec 测试用例清单跑全绿才问 merge;这里是 push-main 的兜底。
  # 实测耗时:media-gen ~1s / adapter-feishu-lark ~12s / app ~12s,合计 ~25s,可接受。
  # 跳过:git push --no-verify(需 commit/改动日志加 [override-pre-push: 理由])。
  # ----------------------------------------------------------
  echo "[pre-push] 跑 fork 自家包单元测试(media-gen / adapter-feishu-lark / app)..."
  fork_unit_fail=0
  (cd packages/media-gen && bun test) || fork_unit_fail=1
  (cd packages/adapter-feishu-lark && bun test) || fork_unit_fail=1
  (cd packages/app && bun run test:unit) || fork_unit_fail=1
  if [ "$fork_unit_fail" = "1" ]; then
    echo ""
    echo "❌ [pre-push] fork 单元测试 fail — push 被拦截"
    echo "(在分支内修绿,或 git push --no-verify [override-pre-push: 理由] 跳过)"
    exit 1
  fi
  echo "✅ [pre-push] fork 单元测试 all pass"

  if ! curl -s -o /dev/null --connect-timeout 2 http://127.0.0.1:3000/; then
    echo ""
    echo "❌ [pre-push] e2e gate 失败:vite mock dev server 没在 :3000 跑"
    echo ""
    echo "请在另一终端启动:"
    echo "    cd packages/app && bun run dev:e2e-mock"
    echo ""
    echo "或跳过 gate(需 commit/改动日志加 [override-pre-push: 理由]):"
    echo "    git push --no-verify"
    exit 1
  fi

  echo "[pre-push] vite mock OK,跑 Phase 1 e2e..."
  if ! (cd packages/app && bunx playwright test --reporter=line); then
    echo ""
    echo "❌ [pre-push] e2e fail — push 被拦截"
    echo "(修 fail 测试,或 git push --no-verify [override-pre-push: 理由] 跳过)"
    exit 1
  fi
  echo "✅ [pre-push] e2e all pass"
fi
