#!/bin/sh
# ============================================================
# opencode-fork pre-commit hook（fork 自加，upstream 不存在此文件）
# 实现 09-改动规则.md 节 4 的 3 道自动化护栏：
#   4.1 文件路径白名单/黑名单（含注册型扩展点豁免）
#   4.2 diff 体量阈值（>500 行警告，规范 v2 由 200 调整为 500）
#   4.4 大小写冲突检查（防 Windows/macOS 端崩）
#
# 跳过方式: git commit --no-verify（必须在 commit 信息或 改动日志.md 显式说明）
# ============================================================

set -e

# ------------------------------------------------------------
# 4.1 白名单/黑名单
# ------------------------------------------------------------
BLACKLIST_REGEX='^(packages/(console|containers|core|desktop-electron|docs|enterprise|extensions|function|identity|opencode|plugin|script|sdk|shared|slack|storybook|ui|web)/|packages/desktop/src-tauri/(tauri\..+\.conf\.json|build\.rs|capabilities/|icons/|entitlements\.plist)|\.github/|bunfig\.toml$|.*\.config\.(ts|js|mjs)$|^package\.json$|^bun\.lock$|^tsconfig\.json$|^flake\.lock$|^LICENSE$)'
# 规范 v2(2026-04-27)豁免:注册型扩展点(provider-icons sprite/types)从黑名单豁免。
# 理由:这俩本就是上游设计的"加新 provider"append-only 注册表,每次加 provider 必改,误报率太高。
# 2026-05-01 加 .github/workflows/*-deskfox.yml 豁免:fork-only CI workflow,文件名后缀强制
# 必带 -deskfox(跟上游 workflow 0 重名),不存在"偷改上游 workflow"的风险。
# 2026-06-14 加 *.deskfox.config.* 豁免:fork 自建打包配置(如 electron-builder.deskfox.config.ts),
# 命名强制带 .deskfox 跟上游 config 0 重名,黑名单 *.config.ts 本意是护上游配置,误伤了 fork 自有配置
# (本 session 3 次同文件误伤)。上游 config(vite.config.ts / electron.vite.config.ts 等)仍受保护。
# 2026-06-15 加 fork 主题文件豁免(注册型扩展点,同 provider-icons 道理 — user 拍板):主题靠
# context.tsx 的 import.meta.glob("./themes/*.json") 自动发现,加 fork 主题=往该目录丢一个 json。
# 精确列出 fork 自有主题文件(命名跟上游主题 0 重名),上游主题 json(oc-2/dracula 等)仍受保护。
# 加新 fork 主题时在此追加文件名(同 provider-icons 的精确豁免风格)。详见 docs/features/fox-blue-theme/。
EXCEPTION_REGEX='^packages/ui/src/components/provider-icons/(sprite\.svg|types\.ts)$|^\.github/workflows/.*-deskfox\.yml$|.*\.deskfox\.config\.(ts|js|mjs)$|^packages/ui/src/theme/themes/fox-blue\.(json|test\.ts)$'
SCRIPTS_ALLOWED='^scripts/install-hooks\.sh$'

# 2026-08-10 动态「上游基准树」豁免(REQ-048 最小子集):
# 黑名单按 packages/<dir>/ 整目录前缀拦,但这些目录下 fork 自建文件已有 47 个
# (office-installer.ts / libreoffice.ts 等,上游根本不存在),改它们不是"动上游",
# 却每次触发 R4 override(fork 已累计 69 笔),枚举豁免必然滞后。改为动态判定:
#   命中黑名单 packages 目录前缀段的文件,若在 tag `upstream-base`
#   (= main 最近一次上游 merge 的上游侧 parent,当前 be227503af @1.17.4)
#   的树中**不存在** → fork 自建 → 豁免;存在 → 上游文件 → 照旧拦。
# 约束:
#   - 只对 packages 目录前缀段生效;命中其余黑名单段(根 package.json / bun.lock /
#     *.config.* / .github/ 等)的文件不走此逻辑,行为不变。
#   - fail-closed:tag 不存在(新 clone 未拉 tag)→ 退回纯黑名单行为并提示
#     `git fetch --tags`,绝不 fail-open。
#   - 每次上游 sync 合入后必须把 upstream-base 移到新的上游侧 parent
#     (UPSTREAM-MERGE-GUIDE §5.8),不移则上游新增文件会被误判 fork 自建,闸变松。
# 详见 docs/features/pre-commit-forkfile-exempt/。
PKGDIR_REGEX='^packages/(console|containers|core|desktop-electron|docs|enterprise|extensions|function|identity|opencode|plugin|script|sdk|shared|slack|storybook|ui|web)/'
OTHER_BLACKLIST_REGEX='^packages/desktop/src-tauri/(tauri\..+\.conf\.json|build\.rs|capabilities/|icons/|entitlements\.plist)|^\.github/|^bunfig\.toml$|.*\.config\.(ts|js|mjs)$|^package\.json$|^bun\.lock$|^tsconfig\.json$|^flake\.lock$|^LICENSE$'
UPSTREAM_BASE_TAG='upstream-base'

violations_raw=$(git diff --cached --name-only | grep -E "$BLACKLIST_REGEX" | grep -vE "$EXCEPTION_REGEX" || true)
scripts_violations=$(git diff --cached --name-only | grep -E "^scripts/" | grep -vE "$SCRIPTS_ALLOWED" || true)

have_base_tag=0
if git cat-file -e "${UPSTREAM_BASE_TAG}^{commit}" 2>/dev/null; then
  have_base_tag=1
fi

violations=""
if [ -n "$violations_raw" ]; then
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    if [ "$have_base_tag" = 1 ] \
      && printf '%s' "$f" | grep -qE "$PKGDIR_REGEX" \
      && ! printf '%s' "$f" | grep -qE "$OTHER_BLACKLIST_REGEX" \
      && ! git cat-file -e "${UPSTREAM_BASE_TAG}:$f" 2>/dev/null; then
      # 上游基准树中不存在 = fork 自建文件,豁免
      continue
    fi
    violations="${violations}${f}
"
  done <<EOF
$violations_raw
EOF
fi

if [ -n "$violations" ] || [ -n "$scripts_violations" ]; then
  echo "❌ pre-commit (4.1): 黑名单文件，禁止 commit:"
  [ -n "$violations" ] && printf '%s' "$violations"
  [ -n "$scripts_violations" ] && echo "$scripts_violations"
  echo ""
  if [ "$have_base_tag" = 0 ]; then
    echo "⚠️ 本地没有 tag '${UPSTREAM_BASE_TAG}'(fork 自建文件动态豁免未生效,fail-closed)。"
    echo "   若上面文件其实是 fork 自建的,先: git fetch --tags 再重试 commit。"
    echo ""
  fi
  echo "如果确认要改: git commit --no-verify -m '... [override-blacklist: 理由]'"
  echo "且必须在 改动日志.md 显式记录 override 理由。"
  exit 1
fi

# ------------------------------------------------------------
# 4.2 diff 体量阈值
# ------------------------------------------------------------
# 规范 v2(2026-04-27):200 → 500。理由:实际 feature commit 普遍 200-400 行,200 阈值导致 [large-diff] 频繁覆盖等于规则失效。500 是真实"该停下想想"的体量。
THRESHOLD=500
DIFF_LINES=$(git diff --cached --shortstat 2>/dev/null | awk '{print ($4+0)+($6+0)}')
DIFF_LINES=${DIFF_LINES:-0}

if [ "$DIFF_LINES" -gt "$THRESHOLD" ]; then
  echo "⚠️  pre-commit (4.2): staged diff = ${DIFF_LINES} 行，超过 ${THRESHOLD} 行阈值"
  echo "请考虑拆 commit。如确实必要: git commit --no-verify -m '... [large-diff: 理由]'"
  exit 1
fi

# ------------------------------------------------------------
# 4.4 大小写冲突检查
# ------------------------------------------------------------
dups=$(git ls-files | sort -fu | uniq -di || true)
if [ -n "$dups" ]; then
  echo "❌ pre-commit (4.4): 大小写冲突文件名（Windows/macOS 上会冲突）:"
  echo "$dups"
  echo "请 git mv 改成统一大小写后再 commit"
  exit 1
fi

# ------------------------------------------------------------
# 4.5 网络监听安全(2026-05-10 立,2026-05-25 扩 vite/astro host 覆盖)
# ------------------------------------------------------------
# 防止 dev server / Bun.serve / *.listen 默认绑 0.0.0.0 暴露端口到 LAN/公网。
# 覆盖三类:
#   (a) Bun.serve( — fork 自家 server / plugin
#   (b) *.listen(port, ...) — node http / express 类
#   (c) host: "0.0.0.0" — vite / astro / rollup 类 dev server 配置
# 触发:staged 新增行命中上述任一,且**对应文件**没有 loopback 安全标记
#       (hostname / .listen(...,"127.0.0.1") / host: "127.0.0.1"|"localhost")。
# 豁免:commit message 标 [network-bind-public: <理由>] (走 --no-verify 或后续放宽)。
# 例外路径:测试文件 (__tests__/, .test., .spec.) 不查(测试有时绑 ephemeral port localhost)。
#
# 起源 (c): 2026-05-25 user 装 prod 2026.5.25.1 + R6 audit 时发现
# packages/{app,enterprise}/vite.config.ts + packages/web/astro.config.mjs
# 三处 dev server 长期默认 0.0.0.0 暴露 :3000 / :4321 类端口到 LAN,
# pre-push 自动起 e2e-mock dev server 时撞 R6 违规。把 vite/astro 配置
# 也纳入 §4.5 扫描,防再回归。

unsafe_bind_files=""
STAGED_TS=$(git diff --cached --name-only --diff-filter=AM | grep -E '\.(ts|tsx|js|mjs)$' | grep -vE '__tests__|\.test\.|\.spec\.' || true)

for f in $STAGED_TS; do
  [ -f "$f" ] || continue
  # 取本次 commit 新增行(过 +++ header)
  added=$(git diff --cached -- "$f" | grep -E '^\+' | grep -vE '^\+\+\+' || true)
  # 是否新增了 bind 站点?(三类:Bun.serve / *.listen(port,...) / host: "0.0.0.0")
  if echo "$added" | grep -qE 'Bun\.serve\(|\.listen\(\s*[0-9a-zA-Z_$]|host\s*:\s*["'"'"']0\.0\.0\.0["'"'"']'; then
    # 该文件全文是否含 loopback 安全标记?(三种形式都接受)
    if ! grep -qE 'hostname\s*:\s*["'"'"']?(127\.0\.0\.1|localhost)["'"'"']?|\.listen\([^)]+,\s*["'"'"'](127\.0\.0\.1|localhost)["'"'"']|host\s*:\s*["'"'"'](127\.0\.0\.1|localhost)["'"'"']' "$f"; then
      unsafe_bind_files="$unsafe_bind_files\n  $f"
    fi
  fi
done

if [ -n "$unsafe_bind_files" ]; then
  echo "❌ pre-commit (4.5 网络绑定安全): 检测到新增 server bind 未显式指定 loopback:"
  printf "%b\n" "$unsafe_bind_files"
  echo ""
  echo "默认绑 0.0.0.0 = 暴露端口到所有网卡(LAN/公网)= Win Firewall 弹窗 + 安全风险"
  echo "请加 (任一):"
  echo "  hostname: \"127.0.0.1\"                  (Bun.serve)"
  echo "  .listen(port, \"127.0.0.1\")              (node http)"
  echo "  host: \"127.0.0.1\"                       (vite/astro/rollup server 配置)"
  echo "若确实需要公网监听: git commit --no-verify -m '... [network-bind-public: <理由>]'"
  exit 1
fi

# ------------------------------------------------------------
# 4.6 fork 关键参数守卫(2026-08-09 立,REQ-104)
# ------------------------------------------------------------
# 防止 fork 必需的构建/测试参数在上游 merge 解冲突时被静默丢掉。
#
# 当前守护:packages/app/package.json 的 test:unit / test:unit:watch 必须带
#   --conditions=browser
# 为什么非守不可:缺了它 bun 会把 solid-js 解析到 **server 构建**,createEffect
#   变成 no-op,effect 不执行。参数由 fork commit defc4fe3ea 引入。
#
#   ⚠️ 2026-08-09 实测更正(REQ-104 立项时沿用的"静默假绿"说法**不准确**):
#   实测删掉该参数跑全量 app 单测 = 604 pass / **2 fail**(不是全绿)。两条 fail 都在
#   src/pages/layout/project-restore.test.ts,报的是 `expect(t.opened).toEqual([DIR_A])`
#   收到 `[]` —— 即 effect 没跑。所以**有信号,不是无声**。
#   但这条断言依然必要,因为那个信号是**误导性**的:
#     (a) 报错内容 100% 指向 project-restore 的业务逻辑("REQ-072 折叠竞态…补回"),
#         **零线索指向 package.json 参数** → 解冲突的人会去调试业务代码甚至"修"错东西;
#     (b) 信号只挂在**一个 fork-only 测试文件**上,该文件一旦被重构/删除,信号归零;
#     (c) 只占 2/606,merge 后若本来就有其它 fail(见 REQ-105 Windows 基线),会被淹没。
#   ⇒ 本断言的价值 = 把"两个业务测试莫名其妙红了"换成"一行说清参数丢了"。
#
# 无条件跑(不只在该文件 staged 时):参数可能在任何一笔 commit 里被丢掉。
# 加新的受守护参数时在 GUARDED_SCRIPTS 追加即可。

APP_PKG="packages/app/package.json"
GUARDED_SCRIPTS="test:unit test:unit:watch"
REQUIRED_FLAG="--conditions=browser"

if [ -f "$APP_PKG" ]; then
  param_violations=""
  for s in $GUARDED_SCRIPTS; do
    line=$(grep -E "\"$s\"[[:space:]]*:" "$APP_PKG" || true)
    if [ -z "$line" ]; then
      param_violations="$param_violations\n  $s —— 脚本整条不见了"
    elif ! echo "$line" | grep -q -- "$REQUIRED_FLAG"; then
      param_violations="$param_violations\n  $s —— 缺 $REQUIRED_FLAG"
    fi
  done

  if [ -n "$param_violations" ]; then
    echo "❌ pre-commit (4.6 fork 关键参数守卫): $APP_PKG 的必需参数被改动:"
    printf "%b\n" "$param_violations"
    echo ""
    echo "$REQUIRED_FLAG 是 FORK 必需(REQ-104):缺了 bun 把 solid-js 解析到 server 构建,"
    echo "createEffect 变 no-op → effect 类单测**静默假绿**(照常 pass,不会变红)。"
    echo "上游 merge 解冲突时最容易丢这个参数,请恢复后再 commit。"
    echo "背景与豁免流程见 docs/governance/UPSTREAM-MERGE-GUIDE.md"
    exit 1
  fi
fi

echo "✅ pre-commit: 白名单 / diff 阈值 / 大小写 / 网络绑定 / fork 参数 五项检查通过"
